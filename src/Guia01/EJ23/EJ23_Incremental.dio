                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction TB\n\n    class Program {\n        +Main() void$\n    }\n\n    class SistemaVigilancia {\n        +FetchSurveillanceData() List~RegistroVigilancia~\n        +PrintInfo(registros : List~RegistroVigilancia~) void\n    }\n\n    class IFuenteVigilancia {\n        &lt;&lt;interface&gt;&gt;\n        +ObtenerRegistros() List~RegistroVigilancia~\n    }\n\n    class RegistroVigilancia {\n        -idDispositivo : int\n        -tipo : string\n        -tamanio : string\n        -observaciones : string\n    }\n\n    class Gr0n3Adapter {\n        -idDispositivo : int\n        +ObtenerRegistros() List~RegistroVigilancia~\n    }\n\n    class FalderPAdapter {\n        -falderP : FalderP\n        +ObtenerRegistros() List~RegistroVigilancia~\n    }\n\n    class FlyingGr0n3 {\n        +GetData(id : int) List~Gr0n3Object~$\n    }\n\n    class Gr0n3Object {\n        -size : string\n        -type : string\n        -kind : string\n    }\n\n    class FalderP {\n        +GetData() List~Perr177~\n    }\n\n    class Perr177 {\n        -id : int\n        -datos : List~Perr177Data~\n    }\n\n    class Perr177Data {\n        -type : FPType\n        -size : string\n        -gender : FPGender\n    }\n\n    class FPType {\n        &lt;&lt;enumeration&gt;&gt;\n        HUMAN\n        NO_HUMAN\n    }\n\n    class FPGender {\n        &lt;&lt;enumeration&gt;&gt;\n        MALE\n        FEMALE\n    }\n\n    Program ..&gt; SistemaVigilancia : utiliza\n\n    SistemaVigilancia ..&gt; IFuenteVigilancia : consulta\n    SistemaVigilancia ..&gt; Gr0n3Adapter : crea\n    SistemaVigilancia ..&gt; FalderPAdapter : crea\n\n    Gr0n3Adapter ..|&gt; IFuenteVigilancia\n    FalderPAdapter ..|&gt; IFuenteVigilancia\n\n    Gr0n3Adapter ..&gt; FlyingGr0n3 : consulta\n    FlyingGr0n3 ..&gt; Gr0n3Object : devuelve\n\n    FalderPAdapter --&gt; FalderP : referencia\n    FalderP ..&gt; Perr177 : devuelve\n    Perr177 --&gt; \&quot;0..*\&quot; Perr177Data : datos\n\n    Gr0n3Adapter ..&gt; RegistroVigilancia : genera\n    FalderPAdapter ..&gt; RegistroVigilancia : genera\n    SistemaVigilancia ..&gt; RegistroVigilancia : procesa\n}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AR1YypqPwED9dY2tjdmp-0">
