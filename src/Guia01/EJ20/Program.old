// EJ20, EJ19
using System;
public class Program
{
    public static void Main() //static void Main(string[] args){}
    {
        // Crear empresa
        Empresa empresa = new Empresa();

        // Crear artículos válidos
        Articulo silla = new Articulo(
            "Silla",
            20000
        );

        Articulo mesa = new Articulo(
            "Mesa",
            45000,
            "Mesa de madera"
        );

        Articulo biblioteca = new Articulo(
            "Biblioteca",
            60000,
            "Cinco estantes"
        );

        // Dar de alta los artículos válidos
        empresa.DarDeAlta(silla);
        empresa.DarDeAlta(mesa);
        empresa.DarDeAlta(biblioteca);

        // EJ20
        // Probar artículos con errores
        Console.WriteLine("=== Artículos con error ===");
        // Error en el nombre
        try
        {
            Articulo articuloNombreInvalido = new Articulo(
                "MesaExtremadamenteLarga)", // 23 caracteres
                30000
            );
            empresa.DarDeAlta(articuloNombreInvalido);
        }
        catch (ExceptionArticulo ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }

        // Error en el costo
        try
        {
            Articulo articuloCostoInvalido = new Articulo(
                "Escritorio",
                0 // El costo tiene que ser mayor a 0
            );
            empresa.DarDeAlta(articuloCostoInvalido);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }

        // Error en la observación
        try
        {
            Articulo articuloObservacionInvalida = new Articulo(
                "Estante",
                25000,
                "Observación demasiado extensa para este articulo" // 48 caracteres
            );
            empresa.DarDeAlta(articuloObservacionInvalida);
        }
        catch (ExceptionArticulo ex)
        {

            Console.WriteLine("Error: " + ex.Message);
        }
        Console.WriteLine();

        // Mostrar artículos dados de alta
        foreach (Articulo articulo in empresa.Articulos)
        {
            Console.WriteLine("Nombre              : " + articulo.Nombre);
            Console.WriteLine("Costos de producción: " + articulo.CostoProduccion);
            if (articulo.Observacion != "")
            {
                Console.WriteLine("Observación         : " + articulo.Observacion);
            }
            Console.WriteLine();
        }


        // Crear lista mayorista
        ListaPrecio listaMayorista = new ListaPrecio(
            "Lista Mayorista",
            "31/12/2026",
            TipoListaPrecio.MAYORISTA
        );

        listaMayorista.AgregarArticulo(
            silla,
            30000
        );

        listaMayorista.AgregarArticulo(
            mesa,
            65000
        );

        listaMayorista.AgregarArticulo(
            biblioteca,
            85000
        );

        // Crear lista minorista
        ListaPrecio listaMinorista = new ListaPrecio(
            "Lista Minorista",
            "31/12/2026",
            TipoListaPrecio.MINORISTA
        );

        listaMinorista.AgregarArticulo(
            silla,
            50000 // Cambiamos un valor por fuera de los parámetros para obligar al sistema a actuar
        );

        listaMinorista.AgregarArticulo(
            mesa,
            75000
        );

        listaMinorista.AgregarArticulo(
            biblioteca,
            95000
        );


        // Agregar las listas a la empresa
        empresa.AgregarListaPrecio(listaMayorista);
        empresa.AgregarListaPrecio(listaMinorista);

        // Mostrar lista antes del ajuste
        Console.WriteLine("=== Lista antes del ajuste ===");


        // Mostrar artículos
        Console.WriteLine("=== ARTÍCULOS ===");

        foreach (Articulo articulo in empresa.Articulos)
        {
            Console.WriteLine("Nombre               : " + articulo.Nombre);
            Console.WriteLine("Costo de producción  : " + articulo.CostoProduccion);

            if (articulo.Observacion != "")
            {
                Console.WriteLine("Observación          : " + articulo.Observacion);
            }

            Console.WriteLine();
        }


        // Mostrar listas de precio

        Console.WriteLine("=== LISTAS DE PRECIO ===");

        foreach (ListaPrecio lista in empresa.ListasDePrecio)
        {
            Console.WriteLine("Nombre         : " + lista.Nombre);
            Console.WriteLine("Vigencia       : " + lista.FechaTopeVigencia);
            Console.WriteLine("Tipo           : " + lista.Tipo);

            Console.WriteLine("Detalle        :");

            foreach (DetalleListaPrecio detalle in lista.Detalles)
            {
                Console.WriteLine("Artículo       : " + detalle.Articulo.Nombre);
                Console.WriteLine("Precio de venta: " + detalle.PrecioVenta);

                if (detalle.Articulo.Observacion != "")
                {
                    Console.WriteLine("Observación    : " + detalle.Articulo.Observacion);
                }
            }
            Console.WriteLine();
        }
    }
}