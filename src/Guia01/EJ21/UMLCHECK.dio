                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass Solicitante {\n    -string dni\n    -double sueldoBruto\n    -int antiguedadEmpleoActual\n    +Solicitante(string dni, double sueldoBruto, int antiguedadEmpleoActual)\n    +Dni string\n    +SueldoBruto double\n    +AntiguedadEmpleoActual int\n}\n\nclass Person {\n    -string name\n    -string lastName\n    -DateTime birthDate\n    +Person(string name, string lastName, DateTime birthDate)\n    +Name string\n    +LastName string\n    +BirthDate DateTime\n}\n\nclass PersonIdentity {\n    -Person person\n    -bool datosValidos\n    +PersonIdentity(Person person, bool datosValidos)\n    +getInfo(string dni) Person\n}\n\nclass Prestamo {\n    -double monto\n    -double interes\n    +Prestamo(double monto, double interes)\n    +Monto double\n    +Interes double\n}\n\nclass KokumoBank {\n    -string nombreSucursal\n    +KokumoBank(string nombreSucursal)\n    +NombreSucursal string\n    +EvaluarPrestamo(Solicitante solicitante, PersonIdentity personIdentity) Prestamo\n    -CalcularEdad(DateTime birthDate) int\n}\n\nclass ExcepcionPrestamo {\n    +ExcepcionPrestamo(string mensaje)\n}\n\nclass Exception {\n    &lt;&lt;framework&gt;&gt;\n}\n\nExcepcionPrestamo --|&gt; Exception\n\nPersonIdentity --&gt; Person : contiene\n\nKokumoBank ..&gt; Solicitante : evalua\nKokumoBank ..&gt; PersonIdentity : consulta\nKokumoBank ..&gt; Prestamo : crea\nKokumoBank ..&gt; ExcepcionPrestamo : lanza&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wzhhV_vCKTSaPMe4AQVj-1">
