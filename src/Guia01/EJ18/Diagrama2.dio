                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Casa {\n    -tieneQuincho : bool\n    -tienePileta : bool\n    +ObtenerDescripcion() string\n}\n\nclass Departamento {\n    -piso : int\n    -numeroLetra : string\n    -admiteMascotas : bool\n    +EstaCompleto() bool\n    +ObtenerDescripcion() string\n}\n\nclass DatosCatastrales {\n    -provincia : string\n    -barrio : string\n    -calle : string\n    -altura : int\n    -codigoPostal : string\n    +EstaCompleto() bool\n}\n\nclass Contacto {\n    -nombre : string\n    -apellido : string\n    -telefono : string\n    -correoElectronico : string\n    +EstaCompleto() bool\n}\n\nclass Inmueble {\n    &lt;&lt;abstract&gt;&gt;\n    -datosCatastrales : DatosCatastrales\n    -ambientes : List~Ambiente~\n    -contacto : Contacto\n    -observacion : string\n    -barrioPrivado : bool\n    -tieneGas : bool\n    -tieneCloacas : bool\n    +EstaCompleto() bool\n    +ObtenerDescripcion() string\n}\n\nclass Ambiente {\n    -tipo : string\n    -ancho : double\n    -largo : double\n    -luminoso : bool\n    +EstaCompleto() bool\n}\n\nclass GestorInmuebles {\n    -repositorio : RepositorioInmueblesMemoria\n    +DarDeAlta(inmueble : Inmueble) bool\n    +ObtenerInmuebles() List~Inmueble~\n}\n\nclass RepositorioInmueblesMemoria {\n    -inmuebles : List~Inmueble~\n    +Guardar(inmueble : Inmueble) void\n    +ObtenerTodos() List~Inmueble~\n}\n\nCasa --|&gt; Inmueble\nDepartamento --|&gt; Inmueble\n\nInmueble -- DatosCatastrales\nInmueble -- Ambiente\nInmueble -- Contacto\nGestorInmuebles -- RepositorioInmueblesMemoria\nRepositorioInmueblesMemoria -- Inmueble&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="D5ajNJKNjHssnEEXgakz-1">
