                <mxCell id="108" value="return pasajeros.Count &amp;lt; CalcularCapacidadTotal();" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=0;verticalAlign=top;align=center;" parent="1" vertex="1">
