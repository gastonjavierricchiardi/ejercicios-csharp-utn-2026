                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass EstadoFormacion {\n  &lt;&lt;enumeration&gt;&gt;\n  EN_DEPOSITO\n  DETENIDA\n  EN_MOVIMIENTO\n}\n\nclass Vagon {\n  &lt;&lt;abstract&gt;&gt;\n  +getPesoMaxKg() number\n  +getPasajerosMax() number\n  +esLiviano() boolean\n}\n\nclass VagonPasajeros {\n  +largoMetros number\n  +anchoUtilMetros number\n  +getPesoMaxKg() number\n  +getPasajerosMax() number\n}\n\nclass VagonCarga {\n  +cargaMaxKg number\n  +getPesoMaxKg() number\n  +getPasajerosMax() number\n}\n\nclass Locomotora {\n  +pesoKg number\n  +arrastreMaxKg number\n  +velocidadMaxKmH number\n  +getArrastreUtilKg() number\n}\n\nclass Formacion {\n  +locomotoras Locomotora[]\n  +vagones Vagon[]\n  +estado EstadoFormacion\n  +getPasajerosTotales() number\n  +getCantidadVagonesLivianos() number\n  +getVelocidadMaxKmH() number\n  +getArrastreUtilTotalKg() number\n  +getPesoMaxTotalVagonesKg() number\n  +puedeMoverse() boolean\n  +getEmpujeFaltanteKg() number\n  +getUnidadesTotales() number\n  +getPesoTotalKg() number\n  +esCompleja() boolean\n  +esEficiente() boolean\n}\n\nclass Deposito {\n  +formaciones Formacion[]\n  +locomotorasSueltas Locomotora[]\n  +getVagonesMasPesadosDeCadaFormacion() Vagon[]\n  +necesitaConductorExperimentado() boolean\n  +agregarLocomotoraAFormacion(formacion: Formacion) boolean\n}\n\nVagon &lt;|-- VagonPasajeros\nVagon &lt;|-- VagonCarga\n\nFormacion \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Locomotora : locomotoras\nFormacion \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Vagon : vagones\nFormacion \&quot;1\&quot; --&gt; \&quot;1\&quot; EstadoFormacion : estado\n\nDeposito \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Formacion : formaciones\nDeposito \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Locomotora : locomotorasSueltas&quot;&#xa;}" id="7_k2WBrqlYXng9fYpx95-1">
