                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Envio {\n    &lt;&lt;abstract&gt;&gt;\n    -numeroGuia : int\n    -destino : string\n    -kilometros : double\n    -peso : double\n    -tarifaPorKilometro : double\n    +CalcularCosto() double*\n}\n\nclass Documentacion {\n    -ADICIONAL_FIJO : double$\n    +CalcularCosto() double\n}\n\nclass IAsegurable {\n    &lt;&lt;interface&gt;&gt;\n    +ObtenerValorDeclarado() double\n    +ObtenerDescripcionCobertura() string\n    +TieneSeguroContratado() bool\n    +ContratarSeguro(valorDeclarado : double, descripcionCobertura : string) void\n}\n\nclass Paquete {\n    -COSTO_POR_KILO : double$\n    -valorDeclarado : double\n    -descripcionCobertura : string\n    -seguroContratado : bool\n    +CalcularCosto() double\n    +ObtenerValorDeclarado() double\n    +ObtenerDescripcionCobertura() string\n    +TieneSeguroContratado() bool\n    +ContratarSeguro(valorDeclarado : double, descripcionCobertura : string) void\n}\n\nclass CargaPesada {\n    -COSTO_POR_KILO : double$\n    -RECARGO_EXCESO : double$\n    -pesoMaximoAdmitido : double\n    -valorDeclarado : double\n    -descripcionCobertura : string\n    -seguroContratado : bool\n    +CalcularCosto() double\n    +ObtenerValorDeclarado() double\n    +ObtenerDescripcionCobertura() string\n    +TieneSeguroContratado() bool\n    +ContratarSeguro(valorDeclarado : double, descripcionCobertura : string) void\n}\n\nclass EnvioNoAsegurableException\n\nclass Exception\n\nclass TransportesDelLitoral {\n    -historial : List~Envio~\n    -pendientes : List~Envio~\n    %% C# real: Dictionary&lt;int, Envio&gt;\n    -enviosPorGuia : Dictionary_int_Envio\n    +RegistrarEnvio(envio : Envio) bool\n    +BuscarPorGuia(numeroGuia : int) Envio?\n    +ContratarSeguro(envio : Envio, valorDeclarado : double, descripcionCobertura : string) void\n    +ConsultarProximo() Envio?\n    +Despachar() Envio?\n    +ObtenerHistorial() List~Envio~\n    +CalcularFacturacion() double\n    +CalcularCostoPromedioAsegurados() double\n}\n\nDocumentacion --|&gt; Envio\nPaquete --|&gt; Envio\nPaquete ..|&gt; IAsegurable\nCargaPesada --|&gt; Envio\nCargaPesada ..|&gt; IAsegurable\nEnvioNoAsegurableException --|&gt; Exception\n\nTransportesDelLitoral -- Envio&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AqDXWX1hEIIkQo2qHxFh-1">
