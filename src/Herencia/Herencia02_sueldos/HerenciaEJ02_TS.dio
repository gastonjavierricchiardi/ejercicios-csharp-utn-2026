                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Empleado {\n  - faltas: number\n  + getFaltas(): number\n  + getNeto(): number\n  + getTipo(): string\n  + calcularBonoPresentismoA(): number\n  + calcularBonoPresentismoB(): number\n  + calcularBonoResultado(resultado: ResultadoObjetivo): number\n  + calcularSueldo(bonoPresentismo: number, resultado: ResultadoObjetivo): number\n}\n\nclass Gerente {\n  + getNeto(): number\n  + getTipo(): string\n}\n\nclass Administrativo {\n  + getNeto(): number\n  + getTipo(): string\n}\n\nclass Operador {\n  + getNeto(): number\n  + getTipo(): string\n}\n\nclass Cadete {\n  + getNeto(): number\n  + getTipo(): string\n}\n\nclass ResultadoObjetivo {\n  CUMPLIO_OBJETIVO\n  CUMPLIO_80\n  NO_CUMPLIO\n}\n\nclass Main {\n  + mostrarSueldo(empleado: Empleado, bonoPresentismo: number, resultado: ResultadoObjetivo): void\n  + main(): void\n}\n\nGerente --|&gt; Empleado\nAdministrativo --|&gt; Empleado\nOperador --|&gt; Empleado\nCadete --|&gt; Empleado\n\nEmpleado ..&gt; ResultadoObjetivo\nMain ..&gt; Empleado\nMain ..&gt; ResultadoObjetivo\n&quot;&#xa;}" id="Q3IKAh0S4RiliLL9RAYC-1">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" parent="1" vertex="1">
