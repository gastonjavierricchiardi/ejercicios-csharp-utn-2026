                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Telefono {\n  - marca: string\n  - modelo: string\n  - nivelBateria: number\n  + Telefono(marca: string, modelo: string, nivelBateria: number)\n  + getMarca(): string\n  + setMarca(value: string): void\n  + getModelo(): string\n  + setModelo(value: string): void\n  + getNivelBateria(): number\n  + getPower(): boolean\n  + estaApagado(): boolean\n  + recargar(): void\n  + aplicarConsumoLlamada(unidades: number): void\n  + consumoPorLlamada(unidades: number): number\n}\n\nclass Motorola {\n  - userName: string\n  + Motorola(marca: string, modelo: string, nivelBateria: number, userName: string)\n  + getUserName(): string\n  + setUserName(value: string): void\n  + consumoPorLlamada(unidades: number): number\n}\n\nclass Iphone {\n  - userName: string\n  + Iphone(marca: string, modelo: string, nivelBateria: number, userName: string)\n  + getUserName(): string\n  + setUserName(value: string): void\n  + consumoPorLlamada(unidades: number): number\n}\n\nclass Antena {\n  + Llamadas(desde: Telefono, hacia: Telefono, unidades: number): void\n}\n\nMotorola --|&gt; Telefono\nIphone --|&gt; Telefono\n\nAntena ..&gt; Telefono : usa\n&quot;&#xa;}" id="mtdiOkSDtydjwKXfIE0V-1">
