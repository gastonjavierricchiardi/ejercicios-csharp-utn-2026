                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Actividad {\n        -string nombre\n        -string descripcion\n        -decimal precioMensual\n        -string instructor\n        -string diasYHorarios\n        +decimal PrecioMensual\n    }\n\n    class Promocion {\n        -string nombre\n        -List~Actividad~ actividades\n        -decimal porcentajeDescuento\n        +CalcularDescuento(List~Actividad~ actividadesSocio, decimal cuotaPura) decimal\n    }\n\n    class Gimnasio {\n        -List~Promocion~ promociones\n        -Promocion promocionVigente\n        +AgregarPromocion(Promocion promocion) void\n        +EliminarPromocion(Promocion promocion) void\n        +EstablecerPromocionVigente(Promocion promocion) void\n        +CalcularCuota(Socio socio) decimal\n    }\n\n    class Socio {\n        -string nombre\n        -string apellido\n        -string dni\n        -string direccion\n        -string telefono\n        -string email\n        -List~Actividad~ actividades\n        -ICalculoCuota modalidad\n        +Inscribirse(Actividad actividad) void\n        +CambiarModalidad(ICalculoCuota modalidad) void\n        +CalcularCuota(Promocion promocion) decimal\n    }\n\n    class ICalculoCuota {\n        &lt;&lt;interface&gt;&gt;\n        +CalcularCuota(List~Actividad~ actividades, Promocion promocion) decimal\n    }\n\n    class CuotaPorActividades {\n        +CalcularCuota(List~Actividad~ actividades, Promocion promocion) decimal\n    }\n\n    class CuotaPaseLibre {\n        -decimal precioMensual\n        +CalcularCuota(List~Actividad~ actividades, Promocion promocion) decimal\n    }\n\n    CuotaPorActividades ..|&gt; ICalculoCuota\n    CuotaPaseLibre ..|&gt; ICalculoCuota\n\n    Socio --&gt; ICalculoCuota : modalidad\n    Socio --&gt; \&quot;0..*\&quot; Actividad : realiza\n    Promocion --&gt; \&quot;0..*\&quot; Actividad : incluye\n    Gimnasio --&gt; \&quot;0..*\&quot; Promocion : administra\n\n    Gimnasio ..&gt; Socio : calcula cuota\n    CuotaPorActividades ..&gt; Promocion : calcula descuento&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-3nPBpVEpzrvZVFppeCQ-0">
