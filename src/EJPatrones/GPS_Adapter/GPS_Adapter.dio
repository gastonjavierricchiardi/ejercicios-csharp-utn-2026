                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class ModuloGPS {\n        +ObtenerSatelites() List~string~\n        +ObtenerPosicionActual() CoordenadaGeografica\n        +TransmitirPosicionActual() void\n    }\n\n    class CoordenadaGeografica {\n        -latitud : double\n        -longitud : double\n        +Latitud : double\n        +Longitud : double\n    }\n\n    class CoordenadaUTM {\n        -este : double\n        -norte : double\n        -zona : int\n        -hemisferio : string\n        +Este : double\n        +Norte : double\n        +Zona : int\n        +Hemisferio : string\n    }\n\n    class IPosicionUTM {\n        &lt;&lt;interface&gt;&gt;\n        +ObtenerPosicionUTM() CoordenadaUTM\n    }\n\n    class AdaptadorGPS {\n        -moduloGPS : ModuloGPS\n        +ObtenerPosicionUTM() CoordenadaUTM\n    }\n\n    class PantallaMonitoreo {\n        -vehiculos : List~IPosicionUTM~\n        +AgregarVehiculo(proveedor : IPosicionUTM) void\n        +MostrarPosiciones() void\n    }\n\n    AdaptadorGPS ..|&gt; IPosicionUTM\n    AdaptadorGPS --&gt; ModuloGPS : adapta\n    ModuloGPS --&gt; CoordenadaGeografica : obtiene\n    AdaptadorGPS --&gt; CoordenadaUTM : transforma\n    PantallaMonitoreo --&gt; \&quot;0..*\&quot; IPosicionUTM : consulta&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="RixgWFzhAVN3-kx3ttFI-1">
