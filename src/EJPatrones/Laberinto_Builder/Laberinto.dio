                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class MaterialPared {\n        &lt;&lt;enumeration&gt;&gt;\n        Arbustos\n        Madera\n        Piedra\n        Agua\n    }\n\n    class Dificultad {\n        &lt;&lt;enumeration&gt;&gt;\n        Facil\n        Intermedio\n        Dificil\n    }\n\n    class Pared {\n        &lt;&lt;abstract&gt;&gt;\n        +EsAtravesable() bool*\n    }\n\n    class ParedSolida {\n        -MaterialPared material\n        -bool tienePuerta\n        +Material MaterialPared\n        +TienePuerta bool\n        +EsAtravesable() bool\n    }\n\n    class ParedAgua {\n        +EsAtravesable() bool\n    }\n\n    class Habitacion {\n        -string id\n        -List~Pared~ paredes\n        -Habitacion anterior\n        -Habitacion siguiente\n        +Id string\n        +Anterior Habitacion\n        +Siguiente Habitacion\n        +ObtenerParedes() List~Pared~\n        +PuedeAtravesarse() bool\n    }\n\n    class Laberinto {\n        -int nivel\n        -Dificultad dificultad\n        -List~Habitacion~ habitaciones\n        +Nivel int\n        +Dificultad Dificultad\n        +CantidadHabitaciones int\n        +ObtenerPrimeraHabitacion() Habitacion\n    }\n\n    class ConstructorLaberinto {\n        -Dictionary~int,int~ minimosPorNivel\n        -Laberinto laberinto\n        -bool habitacionesConstruidas\n        +ConfigurarMinimoHabitaciones(int nivel, int cantidad) void\n        +Iniciar(int nivel, Dificultad dificultad) void\n        +ConstruirClasico(MaterialPared material) void\n        +ConstruirModernoUnaDeCada() void\n        +ConstruirModernoDosDeCada(MaterialPared primero, MaterialPared segundo) void\n        +ConstruirSoloAgua() void\n        +ObtenerLaberinto() Laberinto\n    }\n\n    class Personaje {\n        -List~Habitacion~ habitacionesRecorridas\n        -Habitacion habitacionActual\n        -bool logroSalir\n        +Recorrer(Laberinto laberinto) void\n        +CantidadHabitacionesRecorridas() int\n        +ObtenerHabitacionActual() Habitacion\n        +LogroSalir() bool\n    }\n\n    class Program {\n        +Main() void$\n    }\n\n    Pared &lt;|-- ParedSolida\n    Pared &lt;|-- ParedAgua\n\n    Laberinto \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Habitacion : contiene\n    Habitacion \&quot;1\&quot; --&gt; \&quot;4\&quot; Pared : paredes\n    Habitacion \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Habitacion : anterior y siguiente\n\n    ConstructorLaberinto ..&gt; Laberinto : construye\n    ConstructorLaberinto ..&gt; Habitacion : crea\n    Personaje \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Habitacion : recorridas\n    Personaje ..&gt; Laberinto : recorre\n\n    Program ..&gt; ConstructorLaberinto : utiliza\n    Program ..&gt; Personaje : instancia&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MK-eNDaP2SCEHoCFylci-1">
