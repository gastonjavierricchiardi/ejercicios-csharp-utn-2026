            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class CategoriaHabitacion {\n        &lt;&lt;enumeration&gt;&gt;\n        Simple\n        Doble\n        Suite\n    }\n\n    class EstadoHabitacion {\n        &lt;&lt;enumeration&gt;&gt;\n        Disponible\n        Reservada\n    }\n\n    class RegimenAlimenticio {\n        -string codigo\n        -double porcentajeIncremento\n        +Codigo string\n        +PorcentajeIncremento double\n    }\n\n    class Habitacion {\n        -int numero\n        -CategoriaHabitacion categoria\n        -int capacidadMaxima\n        -double precioDiario\n        -EstadoHabitacion estado\n        -List~RegimenAlimenticio~ regimenesDisponibles\n        +Numero int\n        +Categoria CategoriaHabitacion\n        +CapacidadMaxima int\n        +PrecioDiario double\n        +Estado EstadoHabitacion\n        +ObtenerRegimenesDisponibles() List~RegimenAlimenticio~\n        +AdmiteRegimen(RegimenAlimenticio regimen) bool\n    }\n\n    class ITemporada {\n        &lt;&lt;interface&gt;&gt;\n        +Nombre string\n        +CalcularPrecio(Habitacion habitacion, RegimenAlimenticio regimen, int dias) double\n    }\n\n    class TemporadaAlta {\n        +Nombre string\n        +CalcularPrecio(Habitacion habitacion, RegimenAlimenticio regimen, int dias) double\n    }\n\n    class TemporadaBaja {\n        +Nombre string\n        +CalcularPrecio(Habitacion habitacion, RegimenAlimenticio regimen, int dias) double\n    }\n\n    class DetalleReserva {\n        -Habitacion habitacion\n        -RegimenAlimenticio regimen\n        +Habitacion Habitacion\n        +Regimen RegimenAlimenticio\n        +CalcularSubtotal(ITemporada temporada, int dias) double\n    }\n\n    class Reserva {\n        -int numero\n        -DateTime fechaIngreso\n        -DateTime fechaEgreso\n        -string cliente\n        -List~DetalleReserva~ detalles\n        -double precio\n        +Numero int\n        +FechaIngreso DateTime\n        +FechaEgreso DateTime\n        +Cliente string\n        +Precio double\n        +ObtenerDetalles() List~DetalleReserva~\n    }\n\n    class Hotel {\n        -string nombre\n        -List~Habitacion~ habitaciones\n        -List~Reserva~ reservas\n        -ITemporada temporadaActual\n        -int siguienteNumeroReserva\n        +Nombre string\n        +TemporadaActual string\n        +AgregarHabitacion(Habitacion habitacion) void\n        +ListarHabitaciones() List~Habitacion~\n        +CambiarTemporada() void\n        +CrearReserva(string cliente, DateTime fechaIngreso, DateTime fechaEgreso, List~DetalleReserva~ detalles) Reserva\n        +EliminarReserva(int numeroReserva) void\n        +ListarReservas() List~Reserva~\n    }\n\n    class HabitacionReservadaException {\n    }\n\n    class Exception {\n    }\n\n    class Program {\n        +Main() void$\n    }\n\n    ITemporada &lt;|.. TemporadaAlta\n    ITemporada &lt;|.. TemporadaBaja\n\n    Exception &lt;|-- HabitacionReservadaException\n\n    Hotel \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Habitacion : administra\n    Hotel \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reserva : registra\n    Hotel --&gt; ITemporada : estrategia vigente\n\n    Reserva \&quot;1\&quot; --&gt; \&quot;1..*\&quot; DetalleReserva : contiene\n    DetalleReserva --&gt; Habitacion : selecciona\n    DetalleReserva --&gt; RegimenAlimenticio : utiliza\n    DetalleReserva ..&gt; ITemporada : calcula\n\n    Habitacion --&gt; RegimenAlimenticio : admite\n    Habitacion ..&gt; CategoriaHabitacion : categoria\n    Habitacion ..&gt; EstadoHabitacion : estado\n    Habitacion ..&gt; HabitacionReservadaException : lanza\n\n    Program ..&gt; Hotel : utiliza&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6CNSKUnjraRwnCBVBFHW-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
