                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class IArma {\n        &lt;&lt;interface&gt;&gt;\n        +ObtenerDanio() int\n    }\n    class Granadas {\n        +ObtenerDanio() int\n    }\n    class RayoLaser {\n        +ObtenerDanio() int\n    }\n    class Espada {\n        +ObtenerDanio() int\n    }\n\n    class ITraccion {\n        &lt;&lt;interface&gt;&gt;\n        +ConsumoHp int\n        +AutonomiaKm int\n        +DeterioroPorcentaje int\n        +Deteriorar() void\n        +RequiereReemplazo() bool\n    }\n    class Traccion {\n        &lt;&lt;abstract&gt;&gt;\n        -int deterioroPorcentaje\n        +Deteriorar() void\n        +RequiereReemplazo() bool\n    }\n    class RuedaCaucho {\n        +ConsumoHp int\n        +AutonomiaKm int\n    }\n    class Oruga {\n        -ISensorTemperatura sensor\n        +ConsumoHp int\n        +AutonomiaKm int\n        +ObtenerTemperaturaCelsius() double\n    }\n\n    class ISensorTemperatura {\n        &lt;&lt;interface&gt;&gt;\n        +ObtenerTemperaturaCelsius() double\n    }\n    class SensorMekeM0 {\n        -double temperaturaCelsius\n        +ObtenerTemperaturaCelsius() double\n    }\n    class SensorDigitalFahrenheit {\n        -double temperaturaFahrenheit\n        +ObtenerTemperaturaFahrenheit() double\n    }\n    class AdaptadorSensorDigital {\n        -SensorDigitalFahrenheit sensorDigital\n        +ObtenerTemperaturaCelsius() double\n    }\n\n    class Robot {\n        -string numeroSerie\n        -int resistencia\n        -IArma arma\n        -ITraccion traccion\n        +NumeroSerie string\n        +Resistencia int\n        +Traccion ITraccion\n        +PotenciaTraccionDisponibleHp int\n        +EstaOperativo() bool\n        +Atacar(Robot objetivo) void\n        -RecibirDanio(int danio) void\n    }\n\n    class Combate {\n        -Robot robot1\n        -Robot robot2\n        +Simular() Robot\n    }\n\n    IArma &lt;|.. Granadas\n    IArma &lt;|.. RayoLaser\n    IArma &lt;|.. Espada\n    ITraccion &lt;|.. Traccion\n    Traccion &lt;|-- RuedaCaucho\n    Traccion &lt;|-- Oruga\n\n    ISensorTemperatura &lt;|.. SensorMekeM0\n    ISensorTemperatura &lt;|.. AdaptadorSensorDigital\n\n    Robot --&gt; IArma : armamento\n    Robot --&gt; ITraccion : traccion\n    Oruga --&gt; ISensorTemperatura : utiliza\n    AdaptadorSensorDigital --&gt; SensorDigitalFahrenheit : adapta\n    Combate --&gt; Robot : coordina&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="XioO77uNwzWgvqfmV-Fh-1">
