                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Producto {\n        &lt;&lt;abstract&gt;&gt;\n        -nombre : string\n        -codigo : string\n        -precio : decimal\n        +Nombre : string\n        +Codigo : string\n        +Precio : decimal\n        +CalcularPrecio() decimal\n    }\n\n    class Headset {\n        &lt;&lt;abstract&gt;&gt;\n        -bluetooth : bool\n        -noiceCancelling : bool\n    }\n\n    class Webcam {\n        &lt;&lt;abstract&gt;&gt;\n        -resolucion : string\n    }\n\n    class Kit {\n        &lt;&lt;abstract&gt;&gt;\n        -bluetooht : bool\n    }\n\n    class HeadsetGold\n    class HeadsetPlatinum\n    class HeadsetStarter\n\n    class WebcamGold\n    class WebcamPlatinum\n    class WebcamStarter\n\n    class KitGold\n    class KitPlatinum\n    class KitStarter\n\n    class IFabricaCombo {\n        &lt;&lt;interface&gt;&gt;\n        +ObtenerVersion() string\n        +ObtenerProductos() List~Producto~\n    }\n\n    class FabricaGold {\n        +CrearHeadset() Headset\n        +CrearWebcam() Webcam\n        +CrearKit() Kit\n        +ObtenerVersion() string\n        +ObtenerProductos() List~Producto~\n    }\n\n    class FabricaPlatinum {\n        +CrearHeadset() Headset\n        +CrearWebcam() Webcam\n        +CrearKit() Kit\n        +ObtenerVersion() string\n        +ObtenerProductos() List~Producto~\n    }\n\n    class FabricaStarter {\n        +CrearHeadset() Headset\n        +CrearWebcam() Webcam\n        +CrearKit() Kit\n        +ObtenerVersion() string\n        +ObtenerProductos() List~Producto~\n    }\n\n    class Combo {\n        -productos : List~Producto~\n        -version : string\n        -ObtenerProductos(fabrica : IFabricaCombo) void\n        +CalcularPrecioTotal() decimal\n        +ListarProductos() string\n    }\n\n    class Program {\n        +Main() void$\n    }\n\n    Headset --|&gt; Producto\n    Webcam --|&gt; Producto\n    Kit --|&gt; Producto\n\n    HeadsetGold --|&gt; Headset\n    HeadsetPlatinum --|&gt; Headset\n    HeadsetStarter --|&gt; Headset\n\n    WebcamGold --|&gt; Webcam\n    WebcamPlatinum --|&gt; Webcam\n    WebcamStarter --|&gt; Webcam\n\n    KitGold --|&gt; Kit\n    KitPlatinum --|&gt; Kit\n    KitStarter --|&gt; Kit\n\n    FabricaGold ..|&gt; IFabricaCombo\n    FabricaPlatinum ..|&gt; IFabricaCombo\n    FabricaStarter ..|&gt; IFabricaCombo\n\n    FabricaGold ..&gt; HeadsetGold\n    FabricaGold ..&gt; WebcamGold\n    FabricaGold ..&gt; KitGold\n\n    FabricaPlatinum ..&gt; HeadsetPlatinum\n    FabricaPlatinum ..&gt; WebcamPlatinum\n    FabricaPlatinum ..&gt; KitPlatinum\n\n    FabricaStarter ..&gt; HeadsetStarter\n    FabricaStarter ..&gt; WebcamStarter\n    FabricaStarter ..&gt; KitStarter\n\n    Combo --&gt; \&quot;0..*\&quot; Producto\n    Combo ..&gt; IFabricaCombo\n\n    Program ..&gt; Combo&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hXsCuEhuV03p5LAEEeY3-0">
