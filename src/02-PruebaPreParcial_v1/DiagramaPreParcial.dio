                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass Vehiculo {\n    &lt;&lt;abstract&gt;&gt;\n    +Patente : string\n    +Marca : string\n    +Modelo : string\n    +PrecioBasePorDia : double\n    +CalcularCosto(dias : int, kilometrosRecorridos : double) double*\n}\n\nclass Alquiler {\n    +Vehiculo : Vehiculo\n    +Dias : int\n    +KilometrosRecorridos : double\n    +CalcularCostoTotal() double\n}\n\nclass Auto {\n    +CapacidadCarga : double\n    +CalcularCosto(dias : int, kilometrosRecorridos : double) double\n    +ObtenerDescripcion() string\n}\n\nclass Camioneta {\n    +LimiteKilometrosIncluidos : double\n    +CapacidadCarga : double\n    +CalcularCosto(dias : int, kilometrosRecorridos : double) double\n    +ObtenerDescripcion() string\n}\n\nclass CapacidadCargaExcedidaException\n\nclass Exception\n\nclass Empresa {\n    -vehiculos : List~Vehiculo~\n    -alquileres : List~Alquiler~\n    -entregas : List~Entrega~\n    +RegistrarVehiculo(vehiculo : Vehiculo) void\n    +BuscarVehiculo(patente : string) Vehiculo?\n    +RegistrarAlquiler(vehiculo : Vehiculo, dias : int, kilometrosRecorridos : double) Alquiler\n    +RegistrarEntrega(vehiculo : IEntregable, pesoCarga : double) Entrega\n    +ConsultarVehiculos() List~Vehiculo~\n}\n\nclass Entrega {\n    +Vehiculo : IEntregable\n    +PesoCarga : double\n}\n\nclass IEntregable {\n    &lt;&lt;interface&gt;&gt;\n    +CapacidadCarga : double\n    +ObtenerDescripcion() string\n}\n\nclass Moto {\n    +CalcularCosto(dias : int, kilometrosRecorridos : double) double\n}\n\nAuto --|&gt; Vehiculo\nAuto ..|&gt; IEntregable\nCamioneta --|&gt; Vehiculo\nCamioneta ..|&gt; IEntregable\nMoto --|&gt; Vehiculo\nCapacidadCargaExcedidaException --|&gt; Exception\n\nAlquiler -- Vehiculo\nEmpresa -- Vehiculo\nEmpresa -- Alquiler\nEmpresa -- Entrega\nEntrega -- IEntregable&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qzzFEc56HxDxwoRL513T-0">
